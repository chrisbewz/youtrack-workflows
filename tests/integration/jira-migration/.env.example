# Image repository. Override with the corporate registry mirror when inside the network.
YOUTRACK_IMAGE_REPOSITORY=jetbrains/youtrack

# Full Node image used to build the integration runner. Override with a mirror if needed.
RUNNER_NODE_IMAGE=node:22-alpine

# Full YouTrack image build tag. Do not use an unpinned tag such as latest.
YOUTRACK_IMAGE_TAG=

# Host port used by the setup wizard and local browser. Must match the wizard base URL.
YOUTRACK_HOST_PORT=8089

# Permanent token from the local YouTrack test administrator. Keep it out of Git.
YOUTRACK_TEST_TOKEN=

# Dedicated Jira Cloud Free sandbox. Keep the token out of Git.
JIRA_CLOUD_BASE_URL=https://your-sandbox.atlassian.net
JIRA_CLOUD_EMAIL=automation@example.com
JIRA_CLOUD_API_TOKEN=
JIRA_CLOUD_PROJECT_KEY=YTTEST
